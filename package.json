{
  "name": "wpc-edit",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "dev:local": "vite --mode locallib",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text --coverage.reporter=html",
    "test:screen": "playwright test",
    "test:screen:update": "playwright test --update-snapshots",
    "check": "npm run lint && npm test && npm run build && npm run test:screen",
    "hooks:on": "chmod +x .githooks/pre-push && git config core.hooksPath .githooks",
    "hooks:off": "git config --unset core.hooksPath",
    "deploy": "npm run build && cd ./dist && cp index.html 404.html",
    "gh-pages-deploy": "node scripts/gh-pages-deploy.js"
  },
  "dependencies": {
    "@pixi/filter-adjustment": "^5.1.1",
    "@pixi/filter-advanced-bloom": "^5.1.1",
    "@vueuse/core": "^9.12.0",
    "idb": "^7.1.1",
    "pinia": "^2.0.30",
    "pixi.js": "^7.1.2",
    "register-service-worker": "^1.7.2",
    "vue": "^3.2.13",
    "vue-router": "^4.1.6",
    "wpcedit": "^0.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "execa": "latest",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2"
  }
}
