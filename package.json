{
  "name": "wpc-edit",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "deploy": "npm run build && cd ./dist && cp index.html 404.html",
    "gh-pages-deploy": "node scripts/gh-pages-deploy.js"
  },
  "dependencies": {
    "@pixi/filter-adjustment": "^5.1.1",
    "@pixi/filter-advanced-bloom": "^5.1.1",
    "@vueuse/core": "^9.12.0",
    "core-js": "^3.8.3",
    "idb": "^7.1.1",
    "pinia": "^2.0.30",
    "pixi.js": "^7.1.2",
    "register-service-worker": "^1.7.2",
    "vue": "^3.2.13",
    "vue-router": "^4.1.6",
    "wpcedit": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-pwa": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "execa": "latest"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {
      "camelcase": [
        "warn",
        {
          "properties": "always",
          "ignoreDestructuring": true,
          "ignoreImports": true
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
